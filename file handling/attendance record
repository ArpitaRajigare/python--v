def display_students(students):
    print("\nAll Students:")
    for student in students:
        percentage = (student[2] / student[1]) * 100
        print(student[0], student[1], student[2], round(percentage, 2), "%")

def below_75(students):
    print("\nStudents having attendance below 75%:")
    for student in students:
        percentage = (student[2] / student[1]) * 100
        if percentage < 75:
            print(student[0], round(percentage, 2), "%")

