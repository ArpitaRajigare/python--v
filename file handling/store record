file = open("transactions.txt", "w")

n = int(input("Enter number of transactions: "))

for i in range(n):
    transaction = input("Enter transaction type (D/W): ")
    amount = int(input("Enter amount: "))
    file.write(transaction + "," + str(amount) + "\n")

file.close()

file = open("transactions.txt", "r")

total_deposits = 0
total_withdrawals = 0
transactions = []

for line in file:
    transaction, amount = line.strip().split(",")
    amount = int(amount)
    transactions.append(amount)

    if transaction == "D":
        total_deposits += amount
    elif transaction == "W":
        total_withdrawals += amount

file.close()

balance = total_deposits - total_withdrawals
largest = max(transactions)

print("\nTotal Deposits:", total_deposits)
print("Total Withdrawals:", total_withdrawals)
print("Final Balance:", balance)
print("Largest Transaction:", largest)
