students = []
grades = []


def add_student(name, grade):
    students.append(name)
    grades.append(grade)
    print("Students:", students)
    print("Grades:", grades)


def update_grade(name, new_grade):
    if name in students:
        index = students.index(name)
        grades[index] = new_grade
        print("Students:", students)
        print("Grades:", grades)
    else:
        print("Student not found")


def remove_student(name):
    if name in students:
        index = students.index(name)
        students.pop(index)
        grades.pop(index)
        print("Students:", students)
        print("Grades:", grades)
    else:
        print("Student not found")


def calculate_average():
    if grades:
        average = sum(grades) / len(grades)
        print("Grades:", grades)
        print("Average:", average)
    else:
        print("Grades: []")


def extreme_grade():
    if grades:
        print("Grades:", grades)
        print("Highest:", max(grades))
        print("Lowest:", min(grades))
    else:
        print("Grades: []")


while True:

    action = input("Enter action (add/update/remove/average/extreme/exit): ")

    if action == "add":
        name = input("Enter name: ")
        grade = int(input("Enter grade: "))
        add_student(name, grade)

    elif action == "update":
        name = input("Enter name: ")
        grade = int(input("Enter new grade: "))
        update_grade(name, grade)

    elif action == "remove":
        name = input("Enter name: ")
        remove_student(name)

    elif action == "average":
        calculate_average()

    elif action == "extreme":
        extreme_grade()

    elif action == "exit":
        break

    else:
        print("Invalid action")
        