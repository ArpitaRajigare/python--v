book1 = input("Enter the text of Book 1: ")
book2 = input("Enter the text of Book 2: ")

words1 = set(book1.lower().split())
words2 = set(book2.lower().split())

unique_book1 = words1
unique_book2 = words2

common_words = words1.intersection(words2)

only_book1 = words1.difference(words2)
only_book2 = words2.difference(words1)

all_unique_words = words1.union(words2)

print("\nUnique words in Book 1:")
print(unique_book1)

print("\nUnique words in Book 2:")
print(unique_book2)

print("\nCommon words in both books:")
print(common_words)

print("\nWords unique to Book 1:")
print(only_book1)

print("\nWords unique to Book 2:")
print(only_book2)

print("\nTotal number of unique words across both books:")
print(len(all_unique_words))
